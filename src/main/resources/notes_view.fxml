<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.NoteController"
      spacing="8" alignment="TOP_LEFT">

<padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Title:"/>
    <TextField fx:id="titleField" promptText="Enter title"/>

    <Label text="Content:"/>
    <TextArea fx:id="contentArea" prefRowCount="6" wrapText="true"/>

    <Button text="Add" onAction="#handleAddNote"/>

    <Label text="Saved notes:"/>
    <TextArea fx:id="notesDisplay" prefRowCount="10" wrapText="true" editable="false"/>

</VBox>
